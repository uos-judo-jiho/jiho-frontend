{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-unused-vars": "error",
    "no-unused-vars": "off",

    // oxlint 1.80 부터 React Compiler 계열 룰이 correctness 카테고리에 포함되면서
    // 기존 코드가 한꺼번에 걸린다. 아래 세 룰은 이 저장소에서 의도적으로 사용하는
    // 패턴을 오탐으로 잡으므로 끈다.
    //
    // - set-state-in-effect: prop -> 내부 state 동기화, 타이머/옵저버 기반 초기화
    // - refs: 콜백 재생성을 피하려고 최신 prop 을 ref 에 담아 두는 패턴
    // - incompatible-library: react-hook-form 의 watch()
    //
    // react/immutability 는 실제 버그(useState 반환값 직접 변형)를 잡아주므로 켜 둔다.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/incompatible-library": "off"
  },
  "ignorePatterns": [
    "**/build/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/public/prerendered/**",
    "packages/api/src/_generated/**"
  ]
}
