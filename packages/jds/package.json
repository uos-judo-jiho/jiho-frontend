{
  "name": "@packages/jds",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src/style.css",
    "vendor"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "development": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./hook": {
      "development": "./src/hook.ts",
      "types": "./dist/hook.d.ts",
      "default": "./dist/hook.js"
    },
    "./style.css": "./src/style.css",
    "./interactions": {
      "types": "./vendor/awesome-interactions/index.d.ts",
      "default": "./vendor/awesome-interactions/index.js"
    },
    "./interactions/motion": {
      "types": "./vendor/awesome-interactions/motion.d.ts",
      "default": "./vendor/awesome-interactions/motion.js"
    },
    "./interactions/style.css": "./vendor/awesome-interactions/style.css"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@vanilla-extract/dynamic": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
