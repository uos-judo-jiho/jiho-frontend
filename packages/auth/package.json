{
  "name": "@packages/auth",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#shared/*": "./src/shared/*",
    "#features/*": "./src/features/*"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./login": {
      "development": "./src/features/login/index.ts",
      "types": "./dist/login.d.ts",
      "default": "./dist/login.js"
    },
    "./register": {
      "development": "./src/features/register/index.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@packages/api": "workspace:*",
    "clsx": "^2.1.1",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.66.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.11.1",
    "sonner": "^2.0.7"
  }
}
