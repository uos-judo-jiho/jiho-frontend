{
  "name": "@apps/shorts",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://shorts.uosjudo.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:deps && npm run type-check && vite build",
    "build:deps": "pnpm --filter \"@apps/shorts^...\" --no-fail-if-no-match run --if-present build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src -c ../../.oxlintrc.json --max-warnings=0",
    "format": "oxfmt . -c ../../.oxfmtrc.json",
    "format:check": "oxfmt . -c ../../.oxfmtrc.json --check",
    "lint:fix": "oxlint src -c ../../.oxlintrc.json --fix"
  },
  "dependencies": {
    "@packages/api": "workspace:*",
    "@packages/auth": "workspace:*",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.66.11",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.3.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.477.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^6.11.1",
    "rxjs": "^7.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0"
  }
}
