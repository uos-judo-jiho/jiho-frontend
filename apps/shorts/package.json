{
  "name": "@apps/shorts",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://shorts.uosjudo.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:deps && npm run type-check && vite build",
    "build:deps": "pnpm --filter \"@apps/shorts^...\" --no-fail-if-no-match run --if-present build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src -c ../../.oxlintrc.json --max-warnings=0",
    "format": "oxfmt . -c ../../.oxfmtrc.json",
    "format:check": "oxfmt . -c ../../.oxfmtrc.json --check",
    "lint:fix": "oxlint src -c ../../.oxlintrc.json --fix"
  },
  "dependencies": {
    "@packages/api": "workspace:*",
    "@packages/auth": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@use-gesture/react": "^10.3.1",
    "axios": "catalog:",
    "clsx": "catalog:",
    "framer-motion": "^12.43.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "rxjs": "^7.8.2",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0"
  }
}
