{
  "name": "@apps/internal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,sidecar -c cyan,magenta \"vite\" \"npm run sidecar\"",
    "dev:web": "vite",
    "sidecar": "tsx watch server/index.ts",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src server -c ../../.oxlintrc.json --max-warnings=0",
    "format": "oxfmt . -c ../../.oxfmtrc.json",
    "format:check": "oxfmt . -c ../../.oxfmtrc.json --check"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "archiver": "^8.0.0",
    "axios": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
