{
  "name": "@apps/web",
  "version": "2.1.0",
  "private": true,
  "homepage": "https://uosjudo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/uos-judo-jiho"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist build .output .tanstack .nitro",
    "clean:dev": "npm run clean",
    "build": "sh script/build.sh",
    "build:deps": "pnpm --filter \"@apps/web^...\" --no-fail-if-no-match run --if-present build",
    "build:vite": "vite build",
    "build:docker": "npm run clean && sh script/docker-build-local.sh",
    "lint": "oxlint src -c ../../.oxlintrc.json --max-warnings=0",
    "lint:fix": "oxlint src -c ../../.oxlintrc.json --fix",
    "format": "oxfmt . -c ../../.oxfmtrc.json",
    "format:check": "oxfmt . -c ../../.oxfmtrc.json --check",
    "orval": "pnpm --filter @packages/api gen",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "start:prod": "node .output/server/index.mjs",
    "start:docker": "sh script/docker-run-local.sh",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "dev": "vite dev",
    "dev:server": "vite dev"
  },
  "dependencies": {
    "@99mini/logger-client": "^0.1.2",
    "@packages/api": "workspace:*",
    "@radix-ui/react-slot": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axios": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "overlay-kit": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gfm": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "^10.4.20",
    "vite": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
