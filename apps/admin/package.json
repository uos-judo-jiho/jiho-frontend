{
  "name": "@apps/admin",
  "version": "0.2.0",
  "private": true,
  "homepage": "https://admin.uosjudo.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:deps && pnpm run type-check && vite build",
    "build:deps": "pnpm --filter \"@apps/admin^...\" --no-fail-if-no-match run --if-present build",
    "build:prod": "NODE_ENV=production pnpm run build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint src -c ../../.oxlintrc.json --max-warnings=0",
    "lint:fix": "oxlint src -c ../../.oxlintrc.json --fix",
    "format": "oxfmt . -c ../../.oxfmtrc.json",
    "format:check": "oxfmt . -c ../../.oxfmtrc.json --check",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "catalog:",
    "@packages/api": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@uiw/react-markdown-preview": "^5.1.5",
    "@uiw/react-md-editor": "^4.0.8",
    "@vitejs/plugin-react": "catalog:",
    "axios": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.44.0",
    "lucide-react": "catalog:",
    "overlay-kit": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-day-picker": "^9.8.1",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-markdown": "catalog:",
    "remark-breaks": "catalog:",
    "remark-gfm": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "ts-pattern": "^5.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/ui": "catalog:",
    "happy-dom": "^20.8.4",
    "orval": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
